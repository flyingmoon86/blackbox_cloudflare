{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blackbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blackbox-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "blackbox-files"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "R2_BUCKET_NAME": "blackbox-files"
  },
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "env": {
    "production": {
      "name": "blackbox-production",
      "account_id": "ed1a0311296029d00b6301e7c03aaf33",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "npublackbox.online",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "blackbox-production",
          "database_id": "77199158-0ae1-48c1-bc0b-afc833b7c0ef",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "blackbox-files-production"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "R2_BUCKET_NAME": "blackbox-files-production"
      },
      "secrets": {
        "required": ["SESSION_SECRET"]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
